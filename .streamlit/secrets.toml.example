# Copy this file to `.streamlit/secrets.toml` for LOCAL testing only.
# For Streamlit Cloud, enter these values in the app's Settings -> Secrets
# (NOT committed to git).
#
# Never commit real secrets to the repo.

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_ANON_KEY = "YOUR-ANON-KEY"

READER_DB_HOST = "aws-0-ap-northeast-1.pooler.supabase.com"
READER_DB_PORT = "5432"
READER_DB_DATABASE = "postgres"
READER_DB_USER = "postgres.YOUR-PROJECT-REF"
READER_DB_PASSWORD = "YOUR-DB-PASSWORD"
